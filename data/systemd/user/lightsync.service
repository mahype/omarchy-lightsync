[Unit]
Description=LightSync Philips Hue Entertainment service
Documentation=https://github.com/mahype/omarchy-lightsync
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/lightsyncd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
